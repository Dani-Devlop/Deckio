# Deckio API — example environment configuration.
# Copy to `.env` and adjust. In Docker (docker-compose.yml) these are
# provided by the compose environment section instead.

# --- Database ---
# PostgreSQL (production). For quick local dev you may keep the SQLite default.
DATABASE_URL=postgresql+asyncpg://deckio:deckio@localhost:5432/deckio

# --- Security ---
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# --- App ---
# Comma-separated list of allowed origins, or * for all (dev only).
CORS_ORIGINS=*
DEBUG=false
